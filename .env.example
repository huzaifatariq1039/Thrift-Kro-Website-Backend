# Thrift Kro Backend Environment Variables
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thriftkro

# Security: required; generate a unique value with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication lifecycle
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
FRONTEND_PUBLIC_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
